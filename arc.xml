<?xml version="1.0" encoding="utf-8"?>
<root>
  <View name="status_bar" view_layout="stacked" interactive="false" fill_color="transparent">
    <View name="arc" view_layout="stacked" interactive="false" fill_color="transparent" />
    <View name="notches" view_layout="stacked" interactive="false" fill_color="transparent" />
    <TextView name="scale_maximum" value="--" color="FFFFFF" interactive="false" />
    <TextView name="scale_zero" value="0" color="FFFFFF" interactive="false" />
    <View name="input_regions" view_layout="stacked" interactive="false" fill_color="transparent" />
    <BorderView name="position_menu" visible="false" view_layout="vertical" min_size="Point(80,71)" max_size="Point(80,71)" color="0xFF67AFBF" fill_color="0xF0132C38" interactive="true" capture_input="true">
      <TextButton name="position_toggle" label="Lock in place" min_size="Point(-1,23)" text_alignment="center" font_size="12" color="White" hover_color="FFFFFF" pressed_color="A7E0FF" interactive="true" capture_input="true" />
      <TextButton name="position_bulk" label="Unlock all" min_size="Point(-1,23)" text_alignment="center" font_size="12" color="White" hover_color="FFFFFF" pressed_color="A7E0FF" interactive="true" capture_input="true" />
      <TextButton name="position_lock_all" label="Lock all" min_size="Point(-1,23)" text_alignment="center" font_size="12" color="White" hover_color="FFFFFF" pressed_color="A7E0FF" interactive="true" capture_input="true" />
    </BorderView>
  </View>
</root>
